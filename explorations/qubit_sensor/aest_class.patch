diff --git a/source/perturbations.c b/source/perturbations.c
index c78fe43..96b3bb4 100644
--- a/source/perturbations.c
+++ b/source/perturbations.c
@@ -6580,7 +6580,21 @@ int perturbations_einstein(
          second equation below (credits to Guido Walter Pettinari). */
 
       /* equation for psi */
-      ppw->pvecmetric[ppw->index_mt_psi] = y[ppw->pv->index_pt_phi] - 4.5 * (a2/k2) * ppw->rho_plus_p_shear;
+      /* --- OBT AeST quasi-static G_eff modification (V9.0, set via env OBT_AEST_A; 0/unset = LambdaCDM) ---
+         a0(z)=cH(z)/2pi -> a_H/a0=2pi, so x=2pi k/k_H sets the Newton(x>>1)/MOND(x<1) boundary at the
+         horizon at every epoch. mu(x)=x/sqrt(1+x^2); dev_eff=(1-mu)mu^2 (MOND deviation + GR super-horizon
+         cutoff). G_eff factor = 1 + A*dev_eff enhances the matter-felt potential psi on horizon scales. */
+      double obt_mu_aest = 1.0;
+      {
+        const char *obt_env = getenv("OBT_AEST_A");
+        if (obt_env != NULL) {
+          double obt_A = atof(obt_env);
+          double obt_x = 2.0*_PI_*k/a_prime_over_a;          /* a_prime_over_a = aH = comoving k_H (1/Mpc) */
+          double obt_m = obt_x/sqrt(1.0+obt_x*obt_x);        /* mu(x) */
+          obt_mu_aest = 1.0 + obt_A*(1.0-obt_m)*obt_m*obt_m; /* dev_eff = (1-mu)mu^2 */
+        }
+      }
+      ppw->pvecmetric[ppw->index_mt_psi] = obt_mu_aest * y[ppw->pv->index_pt_phi] - 4.5 * (a2/k2) * ppw->rho_plus_p_shear;
 
       /* equation for phi' */
       ppw->pvecmetric[ppw->index_mt_phi_prime] = -a_prime_over_a * ppw->pvecmetric[ppw->index_mt_psi] + 1.5 * (a2/k2) * ppw->rho_plus_p_theta;
